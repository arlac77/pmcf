{
  "extends": "/model/m1",
  "os": "linux",
  "priority": 12,
  "networkInterfaces": {
    "wlan0": {
      "kind": "wlan",
      "hostName": "wlan-1",
      "ipAddresses": "192.168.1.2/24",
      "services": {
        "keepalived": {
          "clusters": {
            "/L1/C1": { "role": "backup" }
          }
        }
      }
    }
  },
  "services": {
    "dns": { "type": "dns", "aliases": "dns", "priority": 7 }
  }
}
