{
  "aliases": "ldap",
  "base": "dc=mf,dc=de",
  "content": {
    "depends": "openldap",
    "group": "config"
  },
  "properties": {
    "certname": "primary",
    "configdir": "/etc/openldap/slapd.d/",
    "datadir": "/var/lib/openldap/",
    "rundir": "/run/openldap/",
    "rootpw": "{SSHA}XXXX",
    "rootdn": "cn=admin,${base}"
  }
}
