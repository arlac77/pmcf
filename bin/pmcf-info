#!/usr/bin/env node
import { extendingAttributeIterator } from "pacc";
import { prepare } from "../src/cli.mjs";

const { root, args, options } = await prepare({
  maxDepth: {
    type: "string",
    short: "d"
  },
  maxEntries: {
    type: "string",
    short: "e"
  }
});

for (const expression of args) {
  const result = root.expression(expression);

  show(result, 0, { maxDepth: 9, maxEntries: 3, short: false, ...options });
}

function show(value, indent, options) {
  if (indent >= options.maxDepth) {
    return;
  }

  switch (typeof value) {
    case "string":
    case "number":
    case "bigint":
      console.log(value);

    case "undefined":
      return;
  }

  if (value instanceof Iterator || Array.isArray(value)) {
    for (const v of value) {
      show(v, indent + 1, options);
    }
  } else {
    const type = value.constructor;
    const prefix = (l = indent) => " ".repeat(l * 2);
    const ml = maxNameLength(type);
    const name = (attribute, l = indent + 1) =>
      prefix(l) + attribute.name.padEnd(ml) + ": ";

    if (value instanceof Set || Array.isArray(value)) {
      console.log([...value].join(" "));
      return;
    }

    if (options.short) {
      console.log(`${prefix()}${value[type.key]}:`);
    } else {
      console.log(`${prefix()}${value.fullName}(${type.name}):`);
    }

    if (indent + 1 >= options.maxDepth) {
      return;
    }

    for (const [path, attribute] of extendingAttributeIterator(
      type,
      attribute =>
        !attribute.key && !attribute.private && attribute.type.primitive
    )) {
      const v = value.attribute(attribute.name);
      if (v !== undefined) {
        if (attribute.collection) {
          const l = [...v];
          if (l.length) {
            if (l.length >= options.maxEntries) {
              l[options.maxEntries] = "...";
              l.length = options.maxEntries + 1;
            }
            if (attribute.separator || l.length === 1) {
              console.log(`${name(attribute)}${l.join(attribute.separator)}`);
            } else {
              console.log(`${name(attribute)}`);
              for (const vv of l) {
                console.log(prefix(indent + 2) + vv);
              }
            }
          }
        } else {
          console.log(`${name(attribute)}${v}`);
        }
      }
    }

    for (const [path, attribute] of extendingAttributeIterator(
      type,
      attribute => !attribute.private && !attribute.type.primitive
    )) {
      const v = value[attribute.name];
      if (v !== undefined) {
        if (attribute.collection) {
          if (attribute.backpointer) {
            if (indent + 2 >= options.maxDepth) {
              console.log(name(attribute), "...");
            } else {
              console.log(name(attribute));

              let n = 0;
              for (const o of v.values()) {
                if (n++ > options.maxEntries) {
                  console.log(prefix(indent + 2) + "...");
                  break;
                }
                show(o, indent + 2, { ...options, short: true });
              }
            }
          } else {
            try {
              const l = [...v];

              if (l.length > 1) {
                console.log(name(attribute));

                if (l.length >= options.maxEntries) {
                  l[options.maxEntries] = { fullName: "..." };
                  l.length = options.maxEntries + 1;
                }

                for (const o of l) {
                  console.log(prefix(indent + 2) + o.fullName);
                }
              } else if (l.length === 1) {
                console.log(name(attribute) + l[0].fullName);
              }
            } catch (e) {
              console.log(name(attribute), v);
            }
          }
        } else {
          console.log(`${name(attribute)}${v.fullName}`);
        }
      }
    }
  }
}

function maxNameLength(type) {
  let maxLength = 0;
  for (const [path, attribute] of extendingAttributeIterator(
    type,
    attribute => !attribute.key && !attribute.private
  )) {
    maxLength = Math.max(maxLength, attribute.name.length);
  }

  return maxLength;
}
